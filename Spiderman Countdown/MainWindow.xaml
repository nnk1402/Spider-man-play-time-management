<Window x:Class="Spiderman_Countdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spiderman_Countdown"
        mc:Ignorable="d"
        Title="SpidermanCountdown" Height="450" Width="800" ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="menuBackground.png"/>
        </Grid.Background>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#FFF7F2F2">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" Direction="-148"/>
            </TextBlock.Effect>
            
            <Bold>
                <Italic FontSize="48" FontFamily="Haettenschweiler" TextDecorations="Underline">
                    Spider-man Play Time Countdown
                </Italic>
            </Bold>
        </TextBlock>

        <!--Time Countdown-->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" 
              Width="340" Height ="300" Margin="0 20 30 0">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF058629" Offset="0.052"/>
                    <GradientStop Color="#FF2E2727" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Effect>
                <DropShadowEffect ShadowDepth="0"  BlurRadius="15" Color="White"/>
            </Grid.Effect>
            <TextBlock Foreground="White" FontSize="40" FontFamily="Haettenschweiler" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="White" Opacity="1" ShadowDepth="0" BlurRadius="20"/>
                </TextBlock.Effect>
                <Italic Foreground="White">
                    Time Countdown
                </Italic>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Foreground="White" FontSize="70" Margin="0,90,0,0"
                       x:Name="txtTimer">
                <TextBlock.Effect>
                    <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="20"/>
                </TextBlock.Effect>
                25:00
            </TextBlock>
            <Button Width="150" Height="40" FontSize="24" FontFamily="Bahnschrift SemiBold Condensed" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,195,0,0" x:Name="btnSetTime" Click="btnsetTime_Click" BorderThickness="1,1,1,1">
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FFFFFEFE"/>
                </Button.Effect>
                <Button.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFE8E8E8" Offset="0"/>
                        <GradientStop Color="#FFA5E80B" Offset="1"/>
                    </RadialGradientBrush>
                </Button.Background>
                <Button.Content>
                    Set time
                </Button.Content>
            </Button>
            <Button Width="150" Height="40" FontSize="24" FontFamily="Bahnschrift SemiBold Condensed" Background="#FFA4C1F0" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Margin="10 0 0 10" x:Name="btnStart" Click="btnStart_Click">
                <Button.Content>
                    Start
                </Button.Content>
            </Button>
            <Button  FontSize="24" FontFamily="Bahnschrift SemiBold Condensed" Background="#FFA4C1F0" Width="150" Height="40"
                     VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0 0 10 10" 
                     x:Name="btnReset" Click="btnReset_Click">
                <Button.Content>
                    Reset
                </Button.Content>
            </Button>
        </Grid>
    </Grid>
</Window>